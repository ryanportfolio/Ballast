# Scratch space: labs, repro scripts, throwaway tooling (see CLAUDE.md)
.tmp/

# Per-machine Claude Code settings
.claude/settings.local.json

# Throwaway localhost TLS cert minted on demand by the perf skill's h2 test
# server. Regenerated whenever it is missing; never belongs in a commit.
.claude/skills/perf/.localhost-*.pem

# Env / secrets
.env
.env.local
.env.*.local

# Dependencies / build output
node_modules/
dist/
build/

# OS noise
Thumbs.db
.DS_Store
debug.log

# --- Ballast: never commit secrets or personal financial data ---
# scripts/check-secrets.mjs enforces the same list as a pre-commit hook and in CI.
.env*
!.env*.example
!.env*.erb
*.sql
*.sql.gz
*.dump
*.pgdump
*.backup
*.sqlite
*.sqlite3
dump.rdb
*.ofx
*.qfx
*.qif
*.qbo
*.pem
*.key
*.p12
*.pfx
/backups/
/config/master.key
/config/credentials/*.key
compose.yml
compose.override.yml
