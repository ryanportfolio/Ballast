<%# locals: (account:, url:) %>

<%= render "accounts/form", account: account, url: url do |form| %>
  <%= render "shared/ruler", classes: "my-4" %>

  <div class="space-y-2">
    <%= form.fields_for :accountable do |credit_card_form| %>
      <div class="flex items-center gap-2">
        <%= credit_card_form.number_field :available_credit,
                                        label: t("credit_cards.form.available_credit"),
                                        placeholder: t("credit_cards.form.available_credit_placeholder"),
                                        min: 0 %>
      </div>

      <div class="flex items-center gap-2">
        <%= credit_card_form.money_field :minimum_payment,
                                        label: t("credit_cards.form.minimum_payment"),
                                        placeholder: t("credit_cards.form.minimum_payment_placeholder"),
                                        default_currency: Current.family.currency %>

        <%= credit_card_form.number_field :apr,
                                        label: t("credit_cards.form.apr"),
                                        placeholder: t("credit_cards.form.apr_placeholder"),
                                        min: 0,
                                        step: 0.01 %>
      </div>

      <div class="flex items-center gap-2">
        <%= credit_card_form.date_field :expiration_date,
                                      label: t("credit_cards.form.expiration_date") %>
        <%= credit_card_form.number_field :annual_fee,
                                        label: t("credit_cards.form.annual_fee"),
                                        placeholder: t("credit_cards.form.annual_fee_placeholder"),
                                        min: 0 %>
      </div>

      <%# The two days that make up the statement cycle. Only the close day is
          load-bearing -- without it there is no telling which charge belongs to
          which statement -- so the due day is allowed to stand on its own for a
          card whose close day came from a provider. %>
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <%= credit_card_form.select :statement_close_day,
                                      options_for_select(
                                        credit_card_day_of_month_options,
                                        credit_card_form.object.statement_close_day
                                      ),
                                      { include_blank: true, label: t("credit_cards.form.statement_close_day") } %>

          <%= credit_card_form.select :due_day,
                                      options_for_select(
                                        credit_card_day_of_month_options,
                                        credit_card_form.object.due_day
                                      ),
                                      { include_blank: true, label: t("credit_cards.form.due_day") } %>
        </div>
        <p class="text-secondary text-xs"><%= t("credit_cards.form.statement_cycle_description") %></p>
      </div>
    <% end %>

    <% simplefin_account = account.provider_account_for("SimplefinAccount") if account.persisted? %>
    <% if simplefin_account %>
      <div class="space-y-1">
        <%= form.fields_for :simplefin, simplefin_account do |simplefin_form| %>
          <%= simplefin_form.select :balance_sign_override,
                                    options_for_select([
                                      [t("credit_cards.form.simplefin_balance_sign_auto"), ""],
                                      [t("credit_cards.form.simplefin_balance_sign_debt"), "debt"],
                                      [t("credit_cards.form.simplefin_balance_sign_credit"), "credit"]
                                    ], simplefin_account.balance_sign_override),
                                    { label: t("credit_cards.form.simplefin_balance_sign_label") } %>
        <% end %>
        <p class="text-secondary text-xs"><%= t("credit_cards.form.simplefin_balance_sign_description") %></p>
      </div>
    <% end %>
  </div>
<% end %>
